# Copy this file to a private env path on the target OpenClaw instance.
# Do not commit real tokens.

ZALO_BOT_TOKEN='<fill-me>'
ZALO_BOT_KEY='b2b'
ZALO_BRIDGE_LABEL='zalo-b2b'
OPENCLAW_AGENT_ID='clawexperts-monitoring'

# Optional safety gate for group chats.
# When enabled, only messages containing one of the comma-separated triggers
# are forwarded into the OpenClaw agent session.
ZALO_REQUIRE_MENTION='false'
ZALO_MENTION_TRIGGERS='@Bot BD Agent'

ZALO_POLL_TIMEOUT_SECONDS='30'
OPENCLAW_AGENT_TIMEOUT_SECONDS='120'
ZALO_REPLY_CHUNK_LIMIT='2000'
